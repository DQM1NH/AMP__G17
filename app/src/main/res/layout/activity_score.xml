<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:backgroundTint="@color/cardview_light_background">

    <!-- Top Bar: Nút Back và Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhận thưởng"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Placeholder Rương đã mở -->
    <TextView
        android:id="@+id/tvChestStatus"
        android:layout_width="194dp"
        android:layout_height="154dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/img_kho_bau_mo"
        android:gravity="center"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold" />

        <!-- Subtitle: KẾT QUẢ THÀNH CÔNG -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="KẾT QUẢ THÀNH CÔNG"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <!-- Khung thông tin phần thưởng (Card Info) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:padding="20dp"
        android:background="@android:drawable/editbox_background">

        <!-- Tên kho báu & Phẩm cấp -->
        <TextView
            android:id="@+id/tvTreasureName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kho báu 01 - Rare"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Label Điểm thưởng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ĐIỂM THƯỞNG"
            android:textSize="16dp"
            android:textColor="#777777" />

        <!-- Số điểm thưởng cộng thêm -->
        <TextView
            android:id="@+id/tvRewardPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+400"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Đường gạch ngang phân cách -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#DDDDDD" />

        <!-- Tổng điểm sau cập nhật -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng điểm sau cập nhật"
            android:textSize="12sp"
            android:textColor="#777777" />

            <TextView
                android:id="@+id/tvTotalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1.600 điểm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_weight="1" />

        <!-- Nút Tiếp tục săn -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#E0E0E0"
            android:text="TIẾP TỤC SĂN"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Nút Xem bảng xếp hạng -->
        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:text="XEM BẢNG XẾP HẠNG"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute" />
</LinearLayout>