<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TREASURE HUNT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Xin chào, người chơi"
                android:textSize="14sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- Badge Hiển thị điểm số & Nút Cài đặt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:drawable/editbox_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Điểm: 0"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_gear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cài đặt"
                app:tint="#000000" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:id="@+id/chestPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvChestName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kho báu 01"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#222222"/>

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- m"
                android:gravity="center"
                android:textSize="30sp"
                android:textColor="#222222"/>

            <Button
                android:id="@+id/btnHunt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BẮT ĐẦU SĂN"/>

            <Button
                android:id="@+id/btnChallenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MỞ THỬ THÁCH"
                android:enabled="false"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUAY LẠI"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMapTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:text="Bản đồ"
            android:backgroundTint="#7E57C2"/>

        <Button
            android:id="@+id/btnRank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xếp hạng"
            android:backgroundTint="#7E57C2"/>
    </LinearLayout>

</LinearLayout>
