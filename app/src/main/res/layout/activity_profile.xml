<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/black">

        <ImageView
            android:id="@+id/btnBackProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:layout_margin="16dp"
            android:contentDescription="Quay lại" />

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            android:background="@drawable/img_kho_bau_mo"
            android:contentDescription="Avatar" />

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/imgAvatar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Tên người chơi"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG TIN TÀI KHOẢN"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email: --"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingVertical="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

            <TextView
                android:id="@+id/tvProfileScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng điểm: 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:paddingVertical="8dp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

            <TextView
                android:id="@+id/tvProfileChests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kho báu đã mở: 0"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnEditProfile"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="ĐỔI TÊN HIỂN THỊ"
        android:backgroundTint="#4CAF50"
        android:textStyle="bold"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="ĐĂNG XUẤT"
        android:backgroundTint="#FF3B30"
        android:textStyle="bold"
        android:textSize="16sp" />

</LinearLayout>
