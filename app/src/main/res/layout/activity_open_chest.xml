<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:backgroundTint="@color/cardview_light_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar: Nút Back và Tiêu đề -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#000000"
                android:contentDescription="Quay lại" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mở rương kho báu"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Khung chứa hình ảnh/mô phỏng Rương Kho Báu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@android:drawable/editbox_background">

            <!-- Hình ảnh Rương (Có thể thay bằng ImageView thực tế) -->
            <ImageView
                android:id="@+id/imgChest"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kho_bau_dong"
                android:contentDescription="Hình rương" />
        </LinearLayout>

        <!-- Khoảng không gian giãn cách (Spacer) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Biểu tượng hướng dẫn lắc điện thoại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <!-- Placeholder cho icon điện thoại kèm mũi tên lắc -->
            <ImageView
                android:id="@+id/imgShakeIcon"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:src="@drawable/phone_shake"
                app:tint="#000000"
                android:contentDescription="Biểu tượng lắc điện thoại" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="LẮC ĐIỆN THOẠI ĐỂ MỞ RƯƠNG"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Khung hiển thị Trạng thái phát hiện lắc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background">

            <TextView
                android:id="@+id/tvShakeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái: Đang chờ phát hiện lắc"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>