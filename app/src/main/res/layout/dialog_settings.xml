<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Tiêu đề Cài đặt -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CÀI ĐẶT TÀI KHOẢN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp" />

    <!-- Thẻ thông tin cá nhân -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN NGƯỜI CHƠI"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSettingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvSettingEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Email: --"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tvSettingScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Điểm hiện tại: 0 điểm"
            android:textSize="14sp"
            android:textColor="#008000"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSettingChests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kho báu đã mở: 0"
            android:textSize="14sp"
            android:textColor="#555555" />
    </LinearLayout>

    <!-- Tuỳ chọn cài đặt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ỨNG DỤNG"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phiên bản: Treasure Hunt v1.0"
            android:textSize="14sp"
            android:textColor="#444444"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Nút Đăng xuất -->
    <Button
        android:id="@+id/btnDialogLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FF3B30"
        android:text="ĐĂNG XUẤT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
