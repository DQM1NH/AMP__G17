<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <!-- Top Bar: Nút Quay lại và Tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bảng xếp hạng"
            android:textSize="30dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Subtitle phụ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sắp xếp theo tổng điểm giảm dần"
        android:textSize="20dp"
        android:textColor="#777777"
        android:layout_marginBottom="20dp" />

    <!-- Khung Podium Top 3 (Bệ vinh danh) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background">

        <!-- Hạng #2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:drawable/editbox_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#2"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvTop2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Text"
                android:textSize="18dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvTop2Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="7.600"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Hạng #1 (Cao nhất) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:drawable/editbox_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1"
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvTop1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Text"
                android:textSize="18dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvTop1Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="8.200"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Hạng #3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:drawable/editbox_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#3"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvTop3Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Text"
                android:textSize="18dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvTop3Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="6.900"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tiêu đề Danh sách xếp hạng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="DANH SÁCH XẾP HẠNG"
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <!-- Header Bảng: Hạng | Người chơi | Điểm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="Hạng"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Người chơi"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điểm"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Dòng #4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="4"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop4Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text"
            android:textColor="#000000"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/tvTop4Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.400"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Dòng #5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="5"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop5Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop5Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.800"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Dòng #6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="6"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop6Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop6Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.100"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Dòng #7 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:drawable/editbox_background">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="7"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop7Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text"
            android:textSize="22dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTop7Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.200"
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Phần thông tin: HẠNG CỦA BẠN -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HẠNG CỦA BẠN"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/tvMyRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="#4"
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMyPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="5.400 điểm"
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </RelativeLayout>
</LinearLayout>